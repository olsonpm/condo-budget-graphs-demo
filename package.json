{
  "name": "condo-budget-graphs",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite -c vite.app.config.mjs",
    "build-app": "vite build -c vite.app.config.mjs",
    "build-login": "vite build -c vite.login.config.mjs",
    "build-server": "cp src/server/* dist",
    "build": "rm -rf dist && mkdir dist && concurrently --kill-others-on-fail 'pnpm build-app' 'pnpm build-login && mv dist/login/login.html dist/login/index.html' 'pnpm build-server'",
    "preview": "vite preview",
    "build-data": "node scripts/build-data/index.mjs",
    "init-demo-config": "mkdir -p config && cp ./demo-config.json config/client.json",
    "build-demo-data": "IS_DEMO=true pnpm build-data",
    "prep-demo": "pnpm init-demo-config && pnpm build-demo-data",
    "build-demo-app": "pnpm prep-demo && vite build -c vite.app.config.mjs --base=/condo-budget-graphs-demo/",
    "preview-demo": "vite preview --outDir './dist/app' --base=/condo-budget-graphs-demo/",
    "build-docker-image": "./scripts/build-docker-image.sh",
    "push-docker-image": "./scripts/push-docker-image.sh",
    "build-and-push-docker-image": "pnpm build-docker-image && pnpm push-docker-image"
  },
  "imports": {
    "#shared": "./shared/index.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.36.0",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/react": "^0.27.16",
    "@mui/material": "^6.5.0",
    "@nivo/core": "^0.88.0",
    "@nivo/line": "^0.88.0",
    "@olsonpm/eslint-config-personal": "github:olsonpm/eslint-config-personal#b000dc4cb06d4c2cb26d63658a9441522b027405",
    "@vitejs/plugin-react": "^4.7.0",
    "axios": "^1.12.2",
    "baseline-browser-mapping": "^2.8.30",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "concurrently": "^9.2.1",
    "cpy": "^12.1.0",
    "dedent": "^1.7.0",
    "deep-eql": "^5.0.2",
    "deepmerge": "^4.3.1",
    "del": "^8.0.1",
    "eslint": "^9.36.0",
    "eslint-import-resolver-vite": "^2.1.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "framer-motion": "^11.18.2",
    "globals": "^15.15.0",
    "make-dir": "^5.1.0",
    "motion": "^12.23.24",
    "postcss": "^8.5.6",
    "postcss-merge-rules": "^7.0.6",
    "postcss-mixins": "^11.0.3",
    "postcss-nested": "^7.0.2",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "query-string": "^9.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "use-breakpoint": "^4.0.6",
    "use-memo-one": "^1.1.3",
    "use-memoized": "^1.0.2",
    "vite": "^5.4.20",
    "vite-plugin-mkcert": "^1.17.8",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "eslintConfig": {
    "extends": "@olsonpm/eslint-config-personal"
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@koa/router": "^13.1.1",
    "common-fp": "^0.1.5",
    "koa": "^2.16.2",
    "koa-bodyparser": "^4.4.1",
    "koa-compose": "^4.1.0",
    "koa-mount": "^4.2.0",
    "koa-session": "^6.4.0",
    "koa-static": "^5.0.0",
    "koa2-session-ioredis": "^1.2.1",
    "serve": "^14.2.5",
    "to-milliseconds": "^1.1.0"
  }
}
